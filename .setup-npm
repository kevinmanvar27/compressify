#!/bin/bash
# Setup script to install fake pnpm wrapper
# This runs before the build process

set -e

echo "=========================================="
echo "Setting up npm-based build environment"
echo "=========================================="

# Create bin directory in home
mkdir -p ~/bin

# Copy fake pnpm to ~/bin
cp pnpm ~/bin/pnpm
chmod +x ~/bin/pnpm

# Add ~/bin to PATH (prepend so it's found first)
export PATH="$HOME/bin:$PATH"

# Disable corepack
export COREPACK_ENABLE_STRICT=0

# Clear pnpm cache
rm -rf ~/.cache/node/corepack 2>/dev/null || true
rm -rf ~/.local/share/pnpm 2>/dev/null || true

echo "=========================================="
echo "✅ Fake pnpm wrapper installed"
echo "=========================================="
echo "PATH: $PATH"
echo "Which pnpm: $(which pnpm 2>/dev/null || echo 'not found')"
echo "=========================================="
