#!/bin/bash
# Hostinger Custom Build Script
# This file overrides default build behavior

set -e

echo "=========================================="
echo "Custom Build Script - Using npm"
echo "=========================================="

# Disable corepack to prevent pnpm
export COREPACK_ENABLE_STRICT=0

# Clear any pnpm cache
rm -rf ~/.cache/node/corepack 2>/dev/null || true

# Use npm explicitly
echo "Installing dependencies with npm..."
npm install --legacy-peer-deps

echo "Building application..."
npm run build

echo "=========================================="
echo "Build completed successfully!"
echo "=========================================="
