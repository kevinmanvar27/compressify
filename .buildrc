# Build configuration for Hostinger
# This file may be read by the build system

[build]
command = "npm install --legacy-peer-deps && npm run build"
publish = ".next"

[build.environment]
NODE_VERSION = "22"
NPM_VERSION = "10"
COREPACK_ENABLE_STRICT = "0"

[context.production]
command = "npm install --legacy-peer-deps && npm run build"
