#!/bin/bash
# Pre-build hook - runs before Hostinger's build process
# This intercepts the build and forces npm usage

set -e

echo "=========================================="
echo "🔧 Pre-build hook: Setting up npm environment"
echo "=========================================="

# Create bin directory
mkdir -p ~/bin

# Copy fake pnpm wrapper
if [ -f "pnpm" ]; then
    cp pnpm ~/bin/pnpm
    chmod +x ~/bin/pnpm
    echo "✅ Fake pnpm wrapper installed to ~/bin/pnpm"
fi

# Prepend ~/bin to PATH
export PATH="$HOME/bin:$PATH"

# Disable corepack
export COREPACK_ENABLE_STRICT=0

# Clear pnpm cache
rm -rf ~/.cache/node/corepack 2>/dev/null || true
rm -rf ~/.local/share/pnpm 2>/dev/null || true

echo "PATH: $PATH"
echo "Which pnpm: $(which pnpm 2>/dev/null || echo 'not found')"

echo "=========================================="
echo "✅ Environment ready - npm will be used"
echo "=========================================="
