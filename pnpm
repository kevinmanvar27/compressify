#!/bin/bash
# Fake pnpm wrapper - redirects all pnpm commands to npm
# This file will be used when Hostinger tries to run "pnpm install"

# Disable corepack to prevent real pnpm from being called
export COREPACK_ENABLE_STRICT=0

# Clear pnpm cache
rm -rf ~/.cache/node/corepack 2>/dev/null || true
rm -rf ~/.local/share/pnpm 2>/dev/null || true

echo "=========================================="
echo "⚠️  pnpm command intercepted - using npm instead"
echo "=========================================="

# Get the command arguments
COMMAND="$@"

# Convert pnpm commands to npm equivalents
case "$COMMAND" in
    "install"*)
        echo "Running: npm install --legacy-peer-deps"
        npm install --legacy-peer-deps
        ;;
    "install --frozen-lockfile"*)
        echo "Running: npm ci --legacy-peer-deps"
        npm ci --legacy-peer-deps || npm install --legacy-peer-deps
        ;;
    "run build"*)
        echo "Running: npm run build"
        npm run build
        ;;
    "run"*)
        # Extract the script name after "run"
        SCRIPT=$(echo "$COMMAND" | sed 's/run //')
        echo "Running: npm run $SCRIPT"
        npm run $SCRIPT
        ;;
    "start"*)
        echo "Running: npm start"
        npm start
        ;;
    "--version"*)
        echo "10.0.0 (npm wrapper)"
        npm --version
        ;;
    *)
        # For any other command, just pass it to npm
        echo "Running: npm $COMMAND"
        npm $COMMAND
        ;;
esac

EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
    echo "=========================================="
    echo "✅ Command completed successfully"
    echo "=========================================="
else
    echo "=========================================="
    echo "❌ Command failed with exit code: $EXIT_CODE"
    echo "=========================================="
fi

exit $EXIT_CODE
